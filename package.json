{
  "name": "apex-motors-backend",
  "version": "1.0.0",
  "description": "APEX MOTORS — contact form backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "psql -U %DB_USER% -d %DB_NAME% -h %DB_HOST% -p %DB_PORT% -f schema.sql",
    "db:seed": "psql -U %DB_USER% -d %DB_NAME% -h %DB_HOST% -p %DB_PORT% -f seed_cars.sql"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18"
  }
}
