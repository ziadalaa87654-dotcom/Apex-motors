# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# ─── Email (SMTP) ─────────────────────────────────────────
# For Gmail: enable "App Passwords" in your Google account,
# then paste the 16-char app password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false           # true only for port 465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Recipient address for incoming inquiries
CONTACT_RECIPIENT=info@apexmotors.com

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=10             # max submissions per window per IP

# ─── JWT Auth ─────────────────────────────────────────────
JWT_SECRET=apex-motors-super-secret-key-change-in-production-2024
JWT_EXPIRES_IN=7d
# ─── Database (PostgreSQL) ────────────────────────────────
DB_USER=postgres
DB_PASS=12345
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apex_motors