# ─── APEX MOTORS — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

# ── PostgreSQL ────────────────────────────────────────────
# Option A: full connection string (recommended for cloud DBs like Supabase, Neon, Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/apex_motors

# Option B: individual fields (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=apex_motors
# DB_USER=postgres
# DB_PASS=yourpassword

# ── Server ────────────────────────────────────────────────
PORT=3000
# Comma-separated list of allowed origins for CORS
# e.g. http://localhost:5500,https://apexmotors.com
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── SMTP (email) ─────────────────────────────────────────
# Leave blank to skip emails (contact form will still save to DB)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# The internal email that receives new contact form submissions
CONTACT_RECIPIENT=info@apexmotors.com
